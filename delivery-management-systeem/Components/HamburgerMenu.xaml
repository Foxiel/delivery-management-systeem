<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="delivery_management_systeem.Components.HamburgerMenu">
    
    <Grid x:Name="MenuOverlay" IsVisible="False" ZIndex="1000">
        <!-- Dim background fills the whole overlay and closes menu when tapped -->
        <BoxView x:Name="OverlayBackground"
                 Color="#80000000"
                 VerticalOptions="FillAndExpand"
                 HorizontalOptions="FillAndExpand">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" NumberOfTapsRequired="1" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Menu panel on the left -->
        <Frame x:Name="MenuPanel" 
               BackgroundColor="#020A02" 
               BorderColor="#00FF41" 
               Padding="8" 
               HasShadow="True"
               VerticalOptions="Start" 
               HorizontalOptions="Start" 
               Margin="10" 
               CornerRadius="8" 
               WidthRequest="280"
               ZIndex="1001">
            <VerticalStackLayout Spacing="12">
                <Button Text="Help" 
                        BackgroundColor="Transparent" 
                        TextColor="#00FF41" 
                        Clicked="OnHelpClicked" />
                <Button x:Name="PauzeButton" 
                        Text="Pauze" 
                        BackgroundColor="Transparent" 
                        TextColor="#00FF41" 
                        Clicked="OnPauseClicked" />
                <Button Text="Settings" 
                        BackgroundColor="Transparent" 
                        TextColor="#00FF41" 
                        Clicked="OnSettingsClicked" />
                <Button Text="Afmelden" 
                        BackgroundColor="Transparent" 
                        TextColor="#FF4444" 
                        Clicked="OnLogoutClicked" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
    
</ContentView>
