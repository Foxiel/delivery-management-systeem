<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="delivery_management_systeem.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#000000"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="30" RowDefinitions="Auto,*">

        <Button
            Text="← TERUG"
            WidthRequest="120"
            HeightRequest="45"
            BackgroundColor="#020A02"
            BorderColor="#00FF41"
            BorderWidth="1"
            TextColor="#00FF41"
            CornerRadius="10"
            Clicked="OnBackClicked" />

        <VerticalStackLayout
            Grid.Row="1"
            VerticalOptions="Center"
            Spacing="25">

            <Label
                Text="HELP &amp; SUPPORT"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#00FF41"
                HorizontalTextAlignment="Center" />

            <Border
                Padding="25"
                BackgroundColor="#020A02"
                Stroke="#00FF41"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="18">

                    <Entry
                        x:Name="SubjectEntry"
                        Placeholder="Onderwerp"
                        TextColor="#00FF41"
                        PlaceholderColor="#00CC33"
                        BackgroundColor="#000000" />

                    <Editor
                        x:Name="DescriptionEditor"
                        Placeholder="Beschrijf je probleem..."
                        HeightRequest="160"
                        TextColor="#00FF41"
                        PlaceholderColor="#00CC33"
                        BackgroundColor="#000000" />

                    <Button
                        Text="TICKET VERZENDEN"
                        HeightRequest="55"
                        BackgroundColor="#020A02"
                        BorderColor="#00FF41"
                        BorderWidth="2"
                        TextColor="#00FF41"
                        CornerRadius="12"
                        Clicked="OnSendTicketClicked" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

    </Grid>
</ContentPage>