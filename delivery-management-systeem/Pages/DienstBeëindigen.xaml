<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="delivery_management_systeem.Pages.DienstBeëindigen"
             Title="Controle Pakketten"
             BackgroundColor="#000000"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#000000">

        <!-- NORMALE CONTENT -->
        <VerticalStackLayout Padding="15" Spacing="15" BackgroundColor="#000000">

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start" Margin="0,6">
                <Button x:Name="MenuButton"
                        Text="≡"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="#00FF41"
                        Clicked="OnMenuClicked"
                        HorizontalOptions="Start" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">

                <VerticalStackLayout Grid.Column="0" Spacing="10">
                    <Label Text="Retour"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#00FF41"
                           HorizontalOptions="Center" />

                    <Border Padding="10"
                            BackgroundColor="#020A02"
                            Stroke="#00FF41"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 8"
                            MinimumHeightRequest="200">

                        <CollectionView ItemsSource="{Binding RetourPakketten}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="10" Spacing="5">
                                        <Label Text="{Binding PakketNummer}"
                                               TextColor="#00FF41"
                                               FontSize="14" />
                                        <BoxView HeightRequest="1"
                                                 BackgroundColor="#00CC33"
                                                 Margin="0,5" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="10">
                    <Label Text="Overige pakketten"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#00FF41"
                           HorizontalOptions="Center" />

                    <Border Padding="10"
                            BackgroundColor="#020A02"
                            Stroke="#00FF41"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 8"
                            MinimumHeightRequest="200">

                        <CollectionView ItemsSource="{Binding OverigePakketten}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="10" Spacing="5">
                                        <Label Text="{Binding PakketNummer}"
                                               TextColor="#00FF41"
                                               FontSize="14" />
                                        <BoxView HeightRequest="1"
                                                 BackgroundColor="#00CC33"
                                                 Margin="0,5" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Border>
                </VerticalStackLayout>

            </Grid>

            <Label Text="{Binding StatusMessage}"
                   TextColor="#00FF41"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,10" />

            <Button Text="Bevestig"
                    HeightRequest="60"
                    BackgroundColor="#020A02"
                    BorderColor="#00FF41"
                    BorderWidth="2"
                    TextColor="#00FF41"
                    CornerRadius="12"
                    FontSize="18"
                    FontAttributes="Bold"
                    IsEnabled="{Binding AreAllPackagesVerified}"
                    Command="{Binding ConfirmPackagesCommand}"
                    VerticalOptions="End" />

        </VerticalStackLayout>

        <!-- OVERLAY MENU OVER DE CONTENT HEEN -->
        <Grid x:Name="MenuOverlay"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </Grid.GestureRecognizers>

            <Frame x:Name="MenuPanel"
                   BackgroundColor="#020A02"
                   BorderColor="#00FF41"
                   Padding="8"
                   HasShadow="True"
                   VerticalOptions="Start"
                   HorizontalOptions="Start"
                   Margin="10"
                   CornerRadius="8"
                   WidthRequest="280"
                   ZIndex="101">

                <VerticalStackLayout Spacing="12">
                    <Button Text="Help"
                            BackgroundColor="Transparent"
                            TextColor="#00FF41"
                            Clicked="OnHelpClickedFromMenu" />

                    <Button x:Name="PauzeButton"
                            Text="Pauze"
                            BackgroundColor="Transparent"
                            TextColor="#00FF41"
                            Clicked="OnPauseClickedFromMenu" />

                    <Button Text="Settings"
                            BackgroundColor="Transparent"
                            TextColor="#00FF41"
                            Clicked="OnSettingsClickedFromMenu" />

                    <Button Text="Afmelden"
                            BackgroundColor="Transparent"
                            TextColor="#FF4444"
                            Clicked="OnLogoutClicked" />
                </VerticalStackLayout>

            </Frame>

        </Grid>

    </Grid>

</ContentPage>