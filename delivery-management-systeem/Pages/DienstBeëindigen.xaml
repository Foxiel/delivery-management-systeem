<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="delivery_management_systeem.Pages.DienstBeëindigen"
             Title="Controle Pakketten"
             BackgroundColor="#000000"
             NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout Padding="15" Spacing="15" BackgroundColor="#000000">

        <!-- Top bar with menu (left) and help (right) -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start" Margin="0,6">
            <Button x:Name="MenuButton"
                        Text="≡"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="#00FF41"
                        Clicked="OnMenuClicked"
                        HorizontalOptions="Start" />

            <!-- spacer in center -->
            <Label Grid.Column="1" />
        </Grid>

        <!-- Overlay menu (hidden by default) -->
        <Grid x:Name="MenuOverlay" IsVisible="False">
            <!-- dim background fills the whole overlay and closes menu when tapped -->
            <BoxView x:Name="OverlayBackground"
                     Color="#80000000"
                     VerticalOptions="FillAndExpand"
                     HorizontalOptions="FillAndExpand">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOverlayTapped" NumberOfTapsRequired="1" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- menu panel on the left -->
            <Frame x:Name="MenuPanel" BackgroundColor="#020A02" BorderColor="#00FF41" Padding="8" HasShadow="True"
                   VerticalOptions="Start" HorizontalOptions="Start" Margin="10" CornerRadius="8" WidthRequest="280">
                <VerticalStackLayout Spacing="12">
                    <Button Text="Help" BackgroundColor="Transparent" TextColor="#00FF41" Clicked="OnHelpClickedFromMenu" />
                    <Button x:Name="PauzeButton" Text="Pauze" BackgroundColor="Transparent" TextColor="#00FF41" Clicked="OnPauseClickedFromMenu" />
                    <Button Text="Settings" BackgroundColor="Transparent" TextColor="#00FF41" Clicked="OnSettingsClickedFromMenu" />
                    <Button Text="Afmelden" BackgroundColor="Transparent" TextColor="#FF4444" Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <!-- WHAT: Package verification grid with two columns
             HOW: Grid with 2 equal-width columns showing "Retour" and "Overige pakketten"
             WHY: Allows users to visually separate return packages from regular packages -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">

            <!-- Column 1: Return Packages -->
            <VerticalStackLayout Grid.Column="0" Spacing="10">
                <Label 
                    Text="Retour"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#00FF41"
                    HorizontalOptions="Center" />

                <!-- WHAT: CollectionView for return packages
                     HOW: Use CollectionView to display bounded collection of packages
                     WHY: Provides efficient, virtualized list rendering for potentially large package collections -->
                <Border Padding="10" 
                        BackgroundColor="#020A02" 
                        Stroke="#00FF41" 
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        MinimumHeightRequest="200">
                    <CollectionView ItemsSource="{Binding RetourPakketten}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="10" Spacing="5">
                                    <Label 
                                        Text="{Binding PakketNummer}"
                                        TextColor="#00FF41"
                                        FontSize="14" />
                                    <BoxView 
                                        HeightRequest="1" 
                                        BackgroundColor="#00CC33" 
                                        Margin="0,5" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <!-- Column 2: Other Packages -->
            <VerticalStackLayout Grid.Column="1" Spacing="10">
                <Label 
                    Text="Overige pakketten"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#00FF41"
                    HorizontalOptions="Center" />

                <!-- WHAT: CollectionView for remaining packages
                     HOW: Same structure as return packages column
                     WHY: Consistent UI for displaying packages in two logical categories -->
                <Border Padding="10" 
                        BackgroundColor="#020A02" 
                        Stroke="#00FF41" 
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        MinimumHeightRequest="200">
                    <CollectionView ItemsSource="{Binding OverigePakketten}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="10" Spacing="5">
                                    <Label 
                                        Text="{Binding PakketNummer}"
                                        TextColor="#00FF41"
                                        FontSize="14" />
                                    <BoxView 
                                        HeightRequest="1" 
                                        BackgroundColor="#00CC33" 
                                        Margin="0,5" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

        </Grid>

        <!-- WHAT: Status message label
             HOW: Display dynamic text from ViewModel binding
             WHY: Provides real-time feedback to user about package verification status -->
        <Label 
            Text="{Binding StatusMessage, StringFormat='Alle pakketten die zijn gescand of meegenomen.'}"
            TextColor="#00FF41"
            FontSize="14"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            Margin="0,10" />

        <!-- WHAT: Confirm button spanning full width
             HOW: Button with full width, disabled state bound to ViewModel property
             WHY: Large, accessible button for confirming package verification; disabled when validation fails -->
        <Button 
            Text="Bevestig"
            HeightRequest="60"
            BackgroundColor="#020A02"
            BorderColor="#00FF41"
            BorderWidth="2"
            TextColor="#00FF41"
            CornerRadius="12"
            FontSize="18"
            FontAttributes="Bold"
            IsEnabled="{Binding AreAllPackagesVerified}"
            Command="{Binding ConfirmPackagesCommand}"
            VerticalOptions="End" />

    </VerticalStackLayout>

</ContentPage>
