<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="delivery_management_systeem.Pages.LoginWithCredentialsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#000000"
    NavigationPage.HasNavigationBar="False">

    <Grid Padding="30">

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="25">

            <Label
                Text="INLOGGEN"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="#00FF41"
                HorizontalTextAlignment="Center" />

            <Border
                WidthRequest="330"
                Padding="25"
                BackgroundColor="#020A02"
                Stroke="#00FF41"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="18">

                    <Entry
                        x:Name="UsernameEntry"
                        Placeholder="Gebruikersnaam / e-mail"
                        TextColor="#00FF41"
                        PlaceholderColor="#00CC33"
                        BackgroundColor="#000000" />

                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="Wachtwoord"
                        IsPassword="True"
                        TextColor="#00FF41"
                        PlaceholderColor="#00CC33"
                        BackgroundColor="#000000" />

                    <Button
                        Text="INLOGGEN"
                        HeightRequest="55"
                        BackgroundColor="#020A02"
                        BorderColor="#00FF41"
                        BorderWidth="2"
                        TextColor="#00FF41"
                        CornerRadius="12"
                        Clicked="OnLoginClicked" />

                </VerticalStackLayout>

            </Border>

            <Button
                Text="HELP"
                WidthRequest="320"
                HeightRequest="55"
                BackgroundColor="#020A02"
                BorderColor="#00FF41"
                BorderWidth="2"
                TextColor="#00FF41"
                CornerRadius="12"
                Clicked="OnHelpClicked" />

            <Button
                Text="TERUG NAAR NFC"
                WidthRequest="330"
                HeightRequest="50"
                BackgroundColor="#000000"
                BorderColor="#00FF41"
                BorderWidth="1"
                TextColor="#00FF41"
                CornerRadius="12"
                Clicked="OnBackClicked" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>