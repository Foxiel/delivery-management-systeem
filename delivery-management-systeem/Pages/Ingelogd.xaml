<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="delivery_management_systeem.Pages.Ingelogd"
             BackgroundColor="#000000"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#000000">

        <!-- CONTENT -->
        <VerticalStackLayout Spacing="0" Padding="12">

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start" Margin="0,6">
                <Button x:Name="MenuButton"
                        Text="≡"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="#00FF41"
                        Clicked="OnMenuClicked"
                        HorizontalOptions="Start" />
            </Grid>

            <Label Text="Welkom bezorger"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#00FF41"
                   HorizontalOptions="Center"
                   Margin="0,8" />

            <Frame BackgroundColor="#020A02"
                   BorderColor="#00FF41"
                   CornerRadius="12"
                   Padding="12"
                   Margin="0,8">

                <Grid ColumnDefinitions="60,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <Label Grid.Row="0" Grid.Column="0" Text="ma" TextColor="#00FF41" />
                    <Label Grid.Row="0" Grid.Column="1" Text="13:00 / 20:00" TextColor="#B6FFBF" />

                    <Label Grid.Row="1" Grid.Column="0" Text="di" TextColor="#00FF41" />
                    <Label Grid.Row="1" Grid.Column="1" Text="15:00 / 21:00" TextColor="#B6FFBF" />

                    <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="#003300" Margin="0,8" />

                    <Label Grid.Row="3" Grid.Column="0" Text="wo" TextColor="#00FF41" />
                    <Label Grid.Row="3" Grid.Column="1" Text="-" TextColor="#B6FFBF" />

                    <BoxView Grid.Row="4" Grid.ColumnSpan="2" HeightRequest="1" Color="#003300" Margin="0,8" />

                    <Label Grid.Row="5" Grid.Column="0" Text="do" TextColor="#00FF41" />
                    <Label Grid.Row="5" Grid.Column="1" Text="15:00 / 21:00" TextColor="#B6FFBF" />

                    <Label Grid.Row="6" Grid.Column="0" Text="fr" TextColor="#00FF41" />
                    <Label Grid.Row="6" Grid.Column="1" Text="13:00 / 18:00" TextColor="#B6FFBF" />

                    <BoxView Grid.Row="7" Grid.ColumnSpan="2" HeightRequest="1" Color="#003300" Margin="0,8" />

                    <Label Grid.Row="8" Grid.Column="0" Text="sa" TextColor="#00FF41" />
                    <Label Grid.Row="8" Grid.Column="1" Text="-" TextColor="#B6FFBF" />

                    <Label Grid.Row="9" Grid.Column="0" Text="su" TextColor="#00FF41" />
                    <Label Grid.Row="9" Grid.Column="1" Text="-" TextColor="#B6FFBF" />

                </Grid>
            </Frame>

            <VerticalStackLayout Spacing="6" Margin="0,8">
                <Label Text="Parkeerplek:" TextColor="#00FF41" FontAttributes="Bold" />
                <Label x:Name="ParkeerplekLabel" Text="C1" TextColor="#B6FFBF" FontSize="18" />

                <Label Text="Kenteken:" TextColor="#00FF41" FontAttributes="Bold" Margin="0,6,0,0" />
                <Label x:Name="KentekenLabel" Text="V-123-KL" TextColor="#B6FFBF" FontSize="18" />
            </VerticalStackLayout>

            <BoxView HeightRequest="20" Color="Transparent" />

            <Button Text="DOORGAAN"
                    BackgroundColor="#00FF41"
                    TextColor="#000000"
                    CornerRadius="12"
                    HeightRequest="56"
                    Clicked="OnDoorgaanClicked" />

        </VerticalStackLayout>

        <!-- OVERLAY MENU -->
        <Grid x:Name="MenuOverlay"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </Grid.GestureRecognizers>

            <Frame x:Name="MenuPanel"
                   BackgroundColor="#020A02"
                   BorderColor="#00FF41"
                   Padding="8"
                   HasShadow="True"
                   VerticalOptions="Start"
                   HorizontalOptions="Start"
                   Margin="10"
                   CornerRadius="8"
                   WidthRequest="280"
                   ZIndex="101">

                <VerticalStackLayout Spacing="12">

                    <Button Text="Help"
                            BackgroundColor="Transparent"
                            TextColor="#00FF41"
                            Clicked="OnHelpClickedFromMenu" />

                    <Button x:Name="PauzeButton"
                            Text="Pauze"
                            BackgroundColor="Transparent"
                            TextColor="#00FF41"
                            Clicked="OnPauseClickedFromMenu" />

                    <Button Text="Settings"
                            BackgroundColor="Transparent"
                            TextColor="#00FF41"
                            Clicked="OnSettingsClickedFromMenu" />

                    <Button Text="Afmelden"
                            BackgroundColor="Transparent"
                            TextColor="#FF4444"
                            Clicked="OnLogoutClicked" />

                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>